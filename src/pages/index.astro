---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { CAPITULOS, ORDEN_SECCIONES, NOMBRE_SECCION } from '../capitulos';

const entradas = await getCollection('capitulos');
const publicados = new Set(entradas.map((e) => e.data.capitulo));
---

<Base
  titulo="Ingeniería de ontologías — recorrido por Keet"
  descripcion="Capítulo a capítulo del libro de Keet: resumen, ejercicios resueltos y un caso de estudio verificable en cada uno."
>
  <h1>Ingeniería de ontologías</h1>
  <p class="lead">
    Un recorrido capítulo a capítulo por <i>An Introduction to Ontology
    Engineering</i> de C. Maria Keet. Cada capítulo deja tres cosas: qué dice el
    libro, los ejercicios resueltos paso a paso, y un caso de estudio donde eso se
    aplica a algo que se puede comprobar con un razonador.
  </p>

  <h2>El libro</h2>
  <p>
    Keet, C.M. <i>An Introduction to Ontology Engineering</i>, v1.5 (2020). Libro
    abierto, gratuito, con material suplementario y ejercicios:
    <a href="https://people.cs.uct.ac.za/~mkeet/OEbook/">página del libro</a> ·
    <a href="https://people.cs.uct.ac.za/~mkeet/files/OEbook.pdf">PDF</a> ·
    <a href="https://eng.libretexts.org/Bookshelves/Computer_Science/Programming_and_Computation_Fundamentals/An_Introduction_to_Ontology_Engineering_(Keet)">LibreTexts</a>.
  </p>
  <p>
    Es un libro de texto de universidad, no una introducción divulgativa: da la
    lógica formal detrás de OWL en vez de dar solo recetas de Protégé. Por eso
    conviene como base — las decisiones quedan citables.
  </p>

  <h2>Capítulos</h2>
  {
    CAPITULOS.map((cap) => {
      const secciones = entradas
        .filter((e) => e.data.capitulo === cap.n)
        .sort(
          (a, b) =>
            ORDEN_SECCIONES.indexOf(a.data.seccion) -
            ORDEN_SECCIONES.indexOf(b.data.seccion),
        );
      return (
        <div class="capitulo">
          <h2>
            {publicados.has(cap.n) ? (
              <a href={`/capitulos/${cap.slug}/resumen/`}>
                {cap.n}. {cap.titulo}
              </a>
            ) : (
              <span>
                {cap.n}. {cap.titulo}
              </span>
            )}
          </h2>
          {cap.nota && <p>{cap.nota}</p>}
          {secciones.length > 0 ? (
            <ul class="secciones">
              {secciones.map((s) => (
                <li>
                  <a href={`/capitulos/${s.id}/`}>
                    {NOMBRE_SECCION[s.data.seccion]}
                  </a>
                </li>
              ))}
            </ul>
          ) : (
            <p class="pendiente">pendiente</p>
          )}
        </div>
      );
    })
  }
</Base>
