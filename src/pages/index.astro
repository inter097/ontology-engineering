---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { CAPITULOS } from '../capitulos';

const entradas = await getCollection('capitulos');
const porCapitulo = new Map(entradas.map((e) => [e.data.capitulo, e]));
---

<Base
  titulo="Ingeniería de ontologías — recorrido por Keet"
  descripcion="Capítulo a capítulo del libro de Keet: qué dice, los ejercicios resueltos y un caso de estudio verificable en cada uno."
>
  <h1>Ingeniería de ontologías</h1>
  <p class="lead">
    Un recorrido capítulo a capítulo por <i>An Introduction to Ontology
    Engineering</i> de C. Maria Keet. Una página por capítulo: qué dice el libro,
    los ejercicios resueltos, y un caso de estudio donde eso se aplica a algo que
    se puede comprobar con un razonador.
  </p>

  <h2>El libro</h2>
  <p>
    Keet, C.M. <i>An Introduction to Ontology Engineering</i>, v1.5 (2020). Libro
    abierto, gratuito, con material suplementario y ejercicios:
    <a href="https://people.cs.uct.ac.za/~mkeet/OEbook/">página del libro</a> ·
    <a href="https://people.cs.uct.ac.za/~mkeet/files/OEbook.pdf">PDF</a> ·
    <a href="https://eng.libretexts.org/Bookshelves/Computer_Science/Programming_and_Computation_Fundamentals/An_Introduction_to_Ontology_Engineering_(Keet)">LibreTexts</a>.
  </p>
  <p>
    Es un libro de texto de universidad, no una introducción divulgativa: da la
    lógica formal detrás de OWL en vez de dar solo recetas de Protégé. Por eso
    conviene como base — las decisiones quedan citables.
  </p>

  <h2>Capítulos</h2>
  {
    CAPITULOS.map((cap) => {
      const entrada = porCapitulo.get(cap.n);
      return (
        <div class="capitulo">
          <h2>
            {entrada ? (
              <a href={`/capitulos/${entrada.id}/`}>
                {cap.n}. {cap.titulo}
              </a>
            ) : (
              <span>
                {cap.n}. {cap.titulo}
              </span>
            )}
          </h2>
          <p>{entrada ? entrada.data.descripcion : cap.nota ?? ''}</p>
          {!entrada && <p class="pendiente">pendiente</p>}
        </div>
      );
    })
  }
</Base>
