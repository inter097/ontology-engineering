---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import TarjetaCapitulo from '../../components/TarjetaCapitulo.astro';
import { CAPITULOS } from '../../capitulos';

const entradas = await getCollection('capitulos');
const porCapitulo = new Map(entradas.map((e) => [e.data.capitulo, e]));
---

<Base
  titulo="Capítulos — Ingeniería de ontologías"
  descripcion="Índice de capítulos del libro de Keet, con el hallazgo y las cifras de cada uno."
>
  <p class="meta">Índice</p>
  <h1 class="medida">Capítulos</h1>
  <p class="lead">
    Numeración de la autora, verificada contra el PDF. La que circula suele estar
    corrida +1. Una página por capítulo.
  </p>

  <div class="rejilla-capitulos">
    {
      CAPITULOS.map((cap) => (
        <TarjetaCapitulo cap={cap} entrada={porCapitulo.get(cap.n)} />
      ))
    }
  </div>
</Base>
