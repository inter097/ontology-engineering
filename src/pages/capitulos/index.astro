---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { CAPITULOS } from '../../capitulos';

const entradas = await getCollection('capitulos');
const porCapitulo = new Map(entradas.map((e) => [e.data.capitulo, e]));
---

<Base
  titulo="Capítulos — Ingeniería de ontologías"
  descripcion="Índice de capítulos del libro de Keet."
>
  <h1>Capítulos</h1>
  <p class="lead">Numeración del autor. Una página por capítulo.</p>

  {
    CAPITULOS.map((cap) => {
      const entrada = porCapitulo.get(cap.n);
      return (
        <div class="capitulo">
          <h2>
            {entrada ? (
              <a href={`/capitulos/${entrada.id}/`}>
                {cap.n}. {cap.titulo}
              </a>
            ) : (
              <span>
                {cap.n}. {cap.titulo}
              </span>
            )}
          </h2>
          {entrada ? (
            <p>{entrada.data.descripcion}</p>
          ) : (
            <p class="pendiente">pendiente</p>
          )}
        </div>
      );
    })
  }
</Base>
