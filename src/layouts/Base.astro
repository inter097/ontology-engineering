---
import '../styles/global.css';

interface Props {
  titulo: string;
  descripcion?: string;
  /** una página de capítulo: se declara como TechArticle y og:type article */
  articulo?: boolean;
}

const { titulo, descripcion, articulo } = Astro.props;
const url = new URL(Astro.url.pathname, Astro.site);

// Sin og:image a propósito: no hay ningún asset que valga la pena servir, y
// una imagen inventada costaría más de lo que aporta.
const datos = {
  '@context': 'https://schema.org',
  '@type': articulo ? 'TechArticle' : 'WebSite',
  name: titulo,
  description: descripcion,
  url: url.href,
  inLanguage: 'es',
  ...(articulo && {
    headline: titulo,
    isPartOf: {
      '@type': 'WebSite',
      name: 'Ingeniería de ontologías',
      url: Astro.site?.href,
    },
    citation: {
      '@type': 'Book',
      name: 'An Introduction to Ontology Engineering',
      author: { '@type': 'Person', name: 'C. Maria Keet' },
      datePublished: '2020',
    },
  }),
};
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    {descripcion && <meta name="description" content={descripcion} />}
    <link rel="canonical" href={url} />

    <meta property="og:type" content={articulo ? 'article' : 'website'} />
    <meta property="og:site_name" content="Ingeniería de ontologías" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:title" content={titulo} />
    <meta property="og:url" content={url} />
    {descripcion && <meta property="og:description" content={descripcion} />}
    <meta name="twitter:card" content="summary" />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(datos)} />

    <meta name="color-scheme" content="light dark" />
    {/* Se aplica antes de pintar para que no haya destello al cargar. */}
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('tema');
          if (t === 'light' || t === 'dark') {
            document.documentElement.setAttribute('data-theme', t);
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <a class="saltar" href="#contenido">Saltar al contenido</a>

    <nav class="top">
      <div class="wrap">
        <a href="/" class="marca">ingeniería de ontologías</a>
        <a href="/capitulos/">capítulos</a>
        <a href="https://people.cs.uct.ac.za/~mkeet/OEbook/">el libro</a>
        <a href="https://github.com/inter097/ontology-engineering">repo</a>
        <button
          class="tema"
          type="button"
          id="tema"
          aria-label="Cambiar entre tema claro y oscuro"
        >
          tema
        </button>
      </div>
    </nav>

    <main id="contenido">
      <div class="wrap">
        <slot />
      </div>
    </main>

    {/* fuera de <main>: dentro no sería un landmark contentinfo */}
    <footer class="pie">
      <div class="wrap">
        <div class="pie-texto">
        Cada decisión de modelado citada contra Keet, C.M. <i>An Introduction to
        Ontology Engineering</i>, v1.5 (2020) — copia en
        <a href="https://github.com/inter097/ontology-engineering/tree/main/libro">/libro</a>.
        Lo que no tiene respaldo en el libro se marca como criterio propio.
        </div>
      </div>
    </footer>

    <script is:inline>
      (function () {
        var boton = document.getElementById('tema');
        if (!boton) return;
        var raiz = document.documentElement;
        boton.addEventListener('click', function () {
          var actual = raiz.getAttribute('data-theme');
          if (!actual) {
            // sin preferencia explícita: partimos de lo que dice el sistema
            actual = window.matchMedia('(prefers-color-scheme: dark)').matches
              ? 'dark'
              : 'light';
          }
          var nuevo = actual === 'dark' ? 'light' : 'dark';
          raiz.setAttribute('data-theme', nuevo);
          try {
            localStorage.setItem('tema', nuevo);
          } catch (e) {}
        });
      })();
    </script>
  </body>
</html>
